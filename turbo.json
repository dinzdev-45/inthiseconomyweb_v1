{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "SESSION_SECRET",
    "ADMIN_ORIGIN",
    "TRUST_PROXY",
    "DOCKER_HOST",
    "TESTCONTAINERS_*",
    "CI"
  ],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL", "SITE_URL", "STOREFRONT_IMAGE_HOSTS", "TRUST_UPSTREAM_PROXY", "NODE_ENV"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^generate", "generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate", "generate"]
    }
  }
}

# Local development only — copy to .env (git-ignored). Never use these values outside your machine.

# Docker Compose PostgreSQL (docker-compose.yml)
POSTGRES_USER=ite
POSTGRES_PASSWORD=ite_dev_password
POSTGRES_DB=inthiseconomy
POSTGRES_PORT=5433

# Connection string matching the values above (used by Prisma and the API in later tasks)
DATABASE_URL=postgresql://ite:ite_dev_password@localhost:5433/inthiseconomy

# API (apps/api). PORT, HOST, LOG_LEVEL, and NODE_ENV have defaults (4000, 0.0.0.0, info, development).
# At least 32 characters. Generate a real one with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-not-for-production-use
# Origin of the admin app (scheme://host[:port], no trailing slash). The only origin allowed CORS on /api/v1/admin.
ADMIN_ORIGIN=http://localhost:3001
# Proxies allowed to set X-Forwarded-For (IPs, CIDRs, loopback/linklocal/uniquelocal, or a hop count).
# Unset trusts nothing. Locally the admin app proxies /api from loopback.
TRUST_PROXY=loopback
# Single store currency for catalog prices (ISO 4217). Server-side only; set before any products exist.
STORE_CURRENCY=IDR

# Admin app (apps/admin, http://localhost:3001). Server-side URL of the API; never sent to browsers.
API_URL=http://127.0.0.1:4000

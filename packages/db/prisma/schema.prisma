// InThisEconomy database schema.
//
// Conventions (see openspec/changes/initial-platform/design.md, D10 and D12):
// - Models and fields are PascalCase/camelCase in Prisma and snake_case in
//   PostgreSQL: every model has @@map("snake_case_plural") and every
//   multi-word field has @map("snake_case").
// - Primary keys: `id String @id @default(uuid(7)) @db.Uuid` (UUIDv7,
//   generated in the app; use newId() from src/id.ts when an id is needed
//   before insert).
// - Timestamps: @db.Timestamptz(3), stored in UTC.
// - Admin-managed models carry createdAt/updatedAt/createdById/updatedById
//   mapped to created_at/updated_at/created_by/updated_by; set the *ById
//   fields with withAttribution() from src/attribution.ts.
// - Money: Int in minor units plus a `currency` Char(3) column.
// - PostgreSQL extensions (e.g. citext) are created in migration SQL, not
//   declared here, to avoid the postgresqlExtensions preview feature.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin identity (specs: admin-authentication, admin-access-control)
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN

  @@map("admin_role")
}

enum AdminStatus {
  ACTIVE
  DEACTIVATED

  @@map("admin_status")
}

/// A staff account. Customers never have accounts.
model AdminUser {
  id                 String      @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (citext).
  email              String      @unique @db.Citext
  passwordHash       String      @map("password_hash")
  role               AdminRole
  status             AdminStatus @default(ACTIVE)
  /// Set when an Owner creates the account with a temporary password.
  mustChangePassword Boolean     @default(false) @map("must_change_password")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Null when created by a system process or the bootstrap command.
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  createdBy AdminUser? @relation("AdminUserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy AdminUser? @relation("AdminUserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAdminUsers AdminUser[]    @relation("AdminUserCreatedBy")
  updatedAdminUsers AdminUser[]    @relation("AdminUserUpdatedBy")
  sessions          AdminSession[]

  // Catalog attribution back-relations (product-domain).
  createdCategories      Category[]       @relation("CategoryCreatedBy")
  updatedCategories      Category[]       @relation("CategoryUpdatedBy")
  createdSizes           Size[]           @relation("SizeCreatedBy")
  updatedSizes           Size[]           @relation("SizeUpdatedBy")
  createdColors          Color[]          @relation("ColorCreatedBy")
  updatedColors          Color[]          @relation("ColorUpdatedBy")
  createdProducts        Product[]        @relation("ProductCreatedBy")
  updatedProducts        Product[]        @relation("ProductUpdatedBy")
  createdProductVariants ProductVariant[] @relation("ProductVariantCreatedBy")
  updatedProductVariants ProductVariant[] @relation("ProductVariantUpdatedBy")
  createdProductImages   ProductImage[]   @relation("ProductImageCreatedBy")
  updatedProductImages   ProductImage[]   @relation("ProductImageUpdatedBy")

  @@map("admin_users")
}

/// A server-side staff session. Only a SHA-256 hash of the cookie token is stored.
model AdminSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Hex-encoded SHA-256 of the session token.
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  adminUserId String    @map("admin_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

// ---------------------------------------------------------------------------
// Catalog (specs: catalog-reference-data, product-management, product-variants-inventory)
//
// Constraints Prisma cannot express are added in the migration's raw SQL and verified by
// apps/api/src/db/catalog-constraints.test.ts:
// - CHECK: prices 0..2,000,000,000 (catalog business limit), stock >= 0, currency, slug, SKU,
//   size-code and hex formats (all stored normalized, so plain unique indexes are case-insensitive)
// - partial unique index: at most one primary image per product. "Exactly one primary when
//   images exist" is guaranteed by the image service, not by the database alone.
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  ARCHIVED

  @@map("category_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  INACTIVE

  @@map("variant_status")
}

model Category {
  id     String         @id @default(uuid(7)) @db.Uuid
  name   String
  /// Lowercase kebab-case; unique among all categories, archived included.
  slug   String         @unique
  status CategoryStatus @default(ACTIVE)

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  products Product[]

  @@map("categories")
}

/// Size master data: any sizing system (S…XXL, OS, 28, 30/32, EU-42) is rows, not an enum.
model Size {
  id        String @id @default(uuid(7)) @db.Uuid
  /// Normalized uppercase code, unique.
  code      String @unique
  label     String
  /// Explicit display order; independent of the code's alphabetical or numeric value.
  sortOrder Int    @map("sort_order")

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("SizeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("SizeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  variants ProductVariant[]

  @@index([sortOrder, code])
  @@map("sizes")
}

model Color {
  id   String  @id @default(uuid(7)) @db.Uuid
  name String
  slug String  @unique
  /// #RRGGBB, uppercase.
  hex  String? @db.Char(7)

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("ColorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("ColorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  variants ProductVariant[]

  @@map("colors")
}

model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  /// Unique among all products, archived included; immutable after first activation (API rule).
  slug            String        @unique
  description     String?
  status          ProductStatus @default(DRAFT)
  categoryId      String        @map("category_id") @db.Uuid
  /// Minor units of `currency`; 0..2,000,000,000 (CHECK in migration).
  basePriceAmount Int           @map("base_price_amount")
  /// ISO 4217; always the store currency (STORE_CURRENCY) at write time.
  currency        String        @db.Char(3)
  /// First activation; never cleared. Drives slug/SKU locks.
  activatedAt     DateTime?     @map("activated_at") @db.Timestamptz(3)

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id                  String        @id @default(uuid(7)) @db.Uuid
  productId           String        @map("product_id") @db.Uuid
  sizeId              String        @map("size_id") @db.Uuid
  colorId             String        @map("color_id") @db.Uuid
  /// Normalized uppercase; unique across all products.
  sku                 String        @unique
  /// Minor units in the product's currency; null = use the product's base price.
  priceOverrideAmount Int?          @map("price_override_amount")
  stockQuantity       Int           @default(0) @map("stock_quantity")
  status              VariantStatus @default(ACTIVE)

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("ProductVariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("ProductVariantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  size       Size           @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color      Color          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  /// Guest cart lines holding this variant (removed with it).
  cartLines  CartLine[]
  /// Order lines for this variant (variants with orders are never removed).
  orderLines OrderLine[]

  /// One variant per size × color within a product (also serves product_id lookups).
  @@unique([productId, sizeId, colorId])
  @@index([sizeId])
  @@index([colorId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// Optional; must belong to the same product (API rule).
  variantId String? @map("variant_id") @db.Uuid
  /// https:// URL or root-relative path (metadata only; files are not stored here).
  url       String
  alt       String
  sortOrder Int     @map("sort_order")
  /// At most one per product (partial unique index in migration).
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by") @db.Uuid
  updatedById String?    @map("updated_by") @db.Uuid
  createdBy   AdminUser? @relation("ProductImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("ProductImageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

/// A guest cart (store-cart-api spec). No customer data: identified only by a random token,
/// stored as a keyed hash. Not admin-managed, so no attribution columns.
model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Hex HMAC-SHA-256 of the cart token (the token itself is never stored).
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Last change + 30 days; a cart past this is treated as not found.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  lines CartLine[]

  @@map("carts")
}

/// One variant in a cart. Prices are never stored: they are read live from the catalog.
model CartLine {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  /// 1..10 (CHECK in migration).
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// One line per variant in a cart (also serves cart_id lookups).
  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_lines")
}

enum OrderStatus {
  AWAITING_PAYMENT
  EXPIRED

  @@map("order_status")
}

/// A guest order (store-checkout-api spec). Holds guest contact and delivery details, returned
/// only with the order's access key. Lines and totals are copies of what was ordered.
model Order {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// ITE- plus 8 Crockford base32 characters (CHECK in migration).
  number            String      @unique
  /// Hex HMAC-SHA-256 of the access key (the key itself is never stored).
  accessKeyHash     String      @unique @map("access_key_hash") @db.Char(64)
  status            OrderStatus @default(AWAITING_PAYMENT)
  /// Lowercased.
  email             String
  name              String
  /// +62… (normalized).
  phone             String
  addressLine1      String      @map("address_line1")
  addressLine2      String?     @map("address_line2")
  city              String
  /// BPS province code, two digits (CHECK in migration).
  province          String      @db.Char(2)
  postalCode        String      @map("postal_code") @db.Char(5)
  note              String?
  /// Minor units of `currency`; non-negative (CHECK in migration).
  subtotalAmount    BigInt      @map("subtotal_amount")
  shippingFeeAmount Int         @map("shipping_fee_amount")
  totalAmount       BigInt      @map("total_amount")
  currency          String      @db.Char(3)
  paymentDeadline   DateTime    @map("payment_deadline") @db.Timestamptz(3)
  placedAt          DateTime    @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt         DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)
  expiredAt         DateTime?   @map("expired_at") @db.Timestamptz(3)

  lines OrderLine[]

  /// The expiry sweeper's lookup.
  @@index([status, paymentDeadline])
  @@map("orders")
}

/// One ordered variant, copied as it was when the order was placed.
model OrderLine {
  id              String @id @default(uuid(7)) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  variantId       String @map("variant_id") @db.Uuid
  productName     String @map("product_name")
  productSlug     String @map("product_slug")
  colorName       String @map("color_name")
  sizeCode        String @map("size_code")
  unitAmount      Int    @map("unit_amount")
  /// 1..10 (CHECK in migration).
  quantity        Int
  lineTotalAmount BigInt @map("line_total_amount")
  /// Display order (the cart's line order).
  position        Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_lines")
}
